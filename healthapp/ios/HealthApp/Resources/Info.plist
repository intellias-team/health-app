<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.healthapp.ios.refresh</string>
		<string>com.healthapp.ios.sync-processing</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HealthApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.healthapp.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>healthapp</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>COGNITO_CLIENT_ID</key>
	<string>$(COGNITO_CLIENT_ID)</string>
	<key>COGNITO_DOMAIN</key>
	<string>$(COGNITO_DOMAIN)</string>
	<key>COGNITO_REGION</key>
	<string>$(COGNITO_REGION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your Bluetooth food scale to log exact portion weights.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take photos of meals to estimate what's on your plate, and scan food barcodes.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>HealthApp reads your activity, energy, heart rate, HRV, sleep, workouts and body measurements to show your daily fuel, training and recovery picture.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>HealthApp saves the meals, water, weight and body fat you log so they're available in Apple Health.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Describe your meal by voice to log it faster.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose meal photos from your library to log food.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your spoken meal description is transcribed into text so the foods can be identified.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
